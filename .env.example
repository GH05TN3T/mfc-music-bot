# Add 1-7 Discord bot tokens as a JSON array. The full setup supports one
# primary music bot plus six companion bots.
BOT_TOKENS_JSON=["PRIMARY_TOKEN","SUPPORT_TOKEN_1","SUPPORT_TOKEN_2","SUPPORT_TOKEN_3","SUPPORT_TOKEN_4","SUPPORT_TOKEN_5","SUPPORT_TOKEN_6"]
BOT_NAMES_JSON=["MFC Music","MFC Music 2","MFC Music 3","MFC Music 4","MFC Music 5","MFC Music 6","MFC Music 7"]

# During testing, set a guild ID for near-instant slash-command registration.
# Leave blank to register commands globally.
DISCORD_GUILD_ID=

# Must match the password in config/application.yml; use a long random value.
LAVALINK_PASSWORD=replace-with-a-long-random-password

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
RESOLVER_URL=http://127.0.0.1:4417
RESOLVER_PORT=4417
POT_PROVIDER_URL=http://127.0.0.1:4416
YT_COOKIES_PATH=/run/secrets/youtube-cookies.txt
YT_DLP_PATH=/opt/yt-dlp/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
